{
  "name": "modelpatrol",
  "version": "1.0.0",
  "description": "Local-first LLM proxy that routes by intent and tracks coding-plan spend across rolling windows.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shiborgi/modelpatrol.git"
  },
  "homepage": "https://github.com/shiborgi/modelpatrol#readme",
  "bugs": {
    "url": "https://github.com/shiborgi/modelpatrol/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "modelpatrol": "./bin/modelpatrol.js"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "dist",
    "!dist/test",
    "docs",
    "README.md",
    "SECURITY.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check",
    "format": "biome check --write",
    "test:run": "node --test dist/test/*.test.js",
    "test": "npm run build && npm run test:run",
    "check": "npm run typecheck && npm run lint && npm run build && npm run test:run",
    "smoke:run": "node scripts/smoke.mjs",
    "smoke": "npm run build && npm run smoke:run",
    "smoke:installed": "node scripts/smoke-installed.mjs",
    "cli-check:run": "node bin/modelpatrol.js --help",
    "cli-check": "npm run build && npm run cli-check:run",
    "verify": "npm run typecheck && npm run lint && npm run build && npm run test:run && npm run smoke:run && npm run cli-check:run",
    "release-check": "npm run build && npm run smoke:installed",
    "prepack": "npm run build"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@types/node": "^22.20.1",
    "typescript": "^5.6.0"
  },
  "keywords": [
    "agents",
    "llm",
    "proxy",
    "routing",
    "cost-tracking",
    "coding-plan"
  ]
}
