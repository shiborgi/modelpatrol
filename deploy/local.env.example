MODELPATROL_API_KEY=replace-with-a-random-gateway-secret-of-at-least-16-characters
# Ollama Cloud API key for the ollama-cloud provider (subscription plan).
OLLAMA_API_KEY=replace-with-your-ollama-cloud-api-key
# xAI API key for the grok provider (subscription plan).
XAI_API_KEY=replace-with-your-xai-api-key
# Provider sessions are owned by their local CLIs (codex, claude, opencode).
# Each request runs in a fresh, empty temporary directory that is removed afterward.
